/**
 * Cloudflare Workers config for the Ship 40 tracker.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ship-40-tracker",
  "account_id": "e7c94b9e0e9c735313456b00fea7168f",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "starship.beyondstagezero.com", "custom_domain": true },
    { "pattern": "ship40.beyondstagezero.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
